{
  "name": "@thefibre/mcp",
  "version": "1.63.8",
  "private": true,
  "description": "The Fibre as an MCP server — an AI assistant acting as an app on the platform, through an app key",
  "type": "module",
  "bin": {
    "fibre-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./person": {
      "types": "./dist/person.d.ts",
      "default": "./dist/person.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@thefibre/shared": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}

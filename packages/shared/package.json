{
  "name": "@thefibre/shared",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui/date-field": {
      "types": "./dist/ui/date-field.d.ts",
      "default": "./dist/ui/date-field.js"
    },
    "./ui/help": {
      "types": "./dist/ui/help.d.ts",
      "default": "./dist/ui/help.js"
    },
    "./ui/photo-field": {
      "types": "./dist/ui/photo-field.d.ts",
      "default": "./dist/ui/photo-field.js"
    },
    "./ui/settings": {
      "types": "./dist/ui/settings.d.ts",
      "default": "./dist/ui/settings.js"
    },
    "./ui/fields": {
      "types": "./dist/ui/fields.d.ts",
      "default": "./dist/ui/fields.js"
    },
    "./ui/profile-form": {
      "types": "./dist/ui/profile-form.d.ts",
      "default": "./dist/ui/profile-form.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

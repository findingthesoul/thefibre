{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @thefibre/web... build",
  "devCommand": "pnpm --filter @thefibre/web dev",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/.next",
  "regions": ["fra1"],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ':!docs' ':!*.md' ':!supabase' ':!apps/api' ':!packages/shared'"
}

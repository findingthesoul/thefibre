# ============================================================
# The Fibre — environment variables
# Copy to .env.local for each app that needs it.
# NEVER commit real values. NEVER put PII-related service keys in Vercel.
# ============================================================

# --- Supabase (managed, Frankfurt) ---
# Public anon key — safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — backend API only, NEVER in Vercel envs
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- API ---
API_BASE_URL=http://localhost:8080
API_PORT=8080
API_JWT_AUDIENCE=authenticated

# --- Frontend → API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- SSO internal secret ---
# Shared between the auth callback handler and the API /sso/resolve endpoint.
# Generate with: openssl rand -hex 32
SSO_INTERNAL_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Google OAuth (configured in Supabase Auth dashboard) ---
# No secrets needed here; Supabase manages them.

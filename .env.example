# ============================================================
# The Fibre — environment variables
# Copy to .env (apps/api) / .env.local (Next apps) as needed.
# NEVER commit real values. NEVER put PII-related service keys in Vercel.
# Groomed 2026-07-07 against what the code actually reads.
# ============================================================

# --- Supabase (managed, West EU) ---
# Public anon key — safe for browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — backend API only, NEVER in Vercel envs
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Send Email Hook shared secret (branded auth emails)
SUPABASE_AUTH_HOOK_SECRET=

# --- API (apps/api) ---
API_PORT=8080
API_JWT_AUDIENCE=authenticated
# Public URL of the API itself (used in links it generates)
PUBLIC_API_URL=http://localhost:8080
# Extra allowed CORS origins, comma-separated (prod subdomains are built in)
CORS_ORIGINS=

# --- Frontends → API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- App URLs (cross-app links, OAuth redirects, emails) ---
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_MEET_URL=http://localhost:3001
NEXT_PUBLIC_THREAD_URL=http://localhost:3002
NEXT_PUBLIC_FIBRE_URL=http://localhost:3000
THREAD_APP_URL=http://localhost:3002
# Cookie domain for cross-subdomain prefs (prod: .thefibre.app)
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- SSO internal secret ---
# Shared between the auth callback handler and the API /sso/resolve endpoint.
# Generate with: openssl rand -hex 32
SSO_INTERNAL_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="The Fibre <hello@thefibre.app>"

# --- Google OAuth (Meet/Thread calendar connect; sign-in OAuth lives in
# the Supabase Auth dashboard, no secrets needed here for that) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the OAuth state JWT. Generate with: openssl rand -hex 32
GOOGLE_STATE_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Meet webhook endpoint secret
STRIPE_WEBHOOK_SECRET=
# Thread webhook endpoint secret (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_THREAD_WEBHOOK_SECRET=

# ============================================================
# The Thread / The Fibre — environment variables
#
# Copy to apps/api/.env (the API) and to apps/<app>/.env.local (a Next app).
# NEVER commit real values. NEVER put a service key in a Vercel project: the
# frontends are stateless and hold no secret that reaches personal data.
#
# Re-audited 2026-10-01 against what the code reads, by
#   node scripts/check-env-example.mjs
# which lists every name the running code reads and fails when this file and
# the code disagree. Run it when you add a variable. (The previous grooming
# was 2026-07-07 and the file had fallen to about half of what the code read.)
#
# NAMES ONLY. Which values each stack holds: docs/environments.md and
# docs/deploy.md. Only the first two blocks are needed to start locally;
# everything below "Integrations" switches a feature on, and each feature
# stays dark (never broken) while its variables are empty.
# ============================================================

# --- Supabase (managed, West EU) — REQUIRED -------------------------------
# There is no local database. Point at the STAGING project for development
# (docs/environments.md), never at production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — the API only, NEVER in a Vercel project
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Send Email Hook shared secret (branded sign-in emails)
SUPABASE_AUTH_HOOK_SECRET=

# --- API (apps/api) — REQUIRED --------------------------------------------
API_PORT=8080
API_JWT_AUDIENCE=authenticated
# Shared between every Next app's auth callback and the API's /sso/* routes;
# also the fallback root for encrypting stored credentials (lib/secret-box.ts).
# Generate with: openssl rand -hex 32
SSO_INTERNAL_SECRET=
# The address the outside world reaches this API on. Feeds every URL that has
# to round-trip: OAuth redirect URIs (Google, Zoom — must match their consoles
# byte for byte), QR and wallet links in emails. lib/public-url.ts.
PUBLIC_API_URL=http://localhost:8080
# A DIFFERENT variable, deliberately: the origin printed in the MCP/OAuth
# discovery documents. Leave empty — it is derived from the Host header, which
# is what lets one API answer on mcp.thefibre.app and on the Fly hostname.
# API_PUBLIC_URL=
# Extra allowed browser origins, comma-separated. Leave empty: production,
# staging and localhost origins are derived (apps/api/src/lib/cors-origins.ts).
CORS_ORIGINS=

# --- Frontends → API -------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Cookie domain for cross-subdomain preferences and SSO (prod: the app's apex)
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Where each app lives (cross-app links, redirects, emails) -------------
# Every one is optional: packages/shared/src/branding.ts holds the production
# address and derives the staging one from the host. Set them for LOCAL dev so
# links between apps stay on localhost.
NEXT_PUBLIC_FIBRE_URL=http://localhost:3000
NEXT_PUBLIC_MEET_URL=http://localhost:3001
NEXT_PUBLIC_THREAD_URL=http://localhost:3002
NEXT_PUBLIC_FLOW_URL=http://localhost:3003
NEXT_PUBLIC_PULSE_URL=http://localhost:3004
NEXT_PUBLIC_MEMBERSHIP_URL=http://localhost:3005
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3006
NEXT_PUBLIC_MY_URL=http://localhost:3007
NEXT_PUBLIC_CONNECTIONS_URL=http://localhost:3008
NEXT_PUBLIC_MODELS_URL=http://localhost:3009
# Registered in the catalogue, nothing built yet
# NEXT_PUBLIC_LEARN_URL=
# The marketing site's "Start" button; defaults to <fibre>/request-access
# NEXT_PUBLIC_SIGNUP_URL=
# The address a person gives their own assistant; derived when empty
# NEXT_PUBLIC_MCP_URL=

# The same addresses as the API needs them, for links it puts in emails and
# payment pages. Each falls back to branding.ts.
THREAD_APP_URL=http://localhost:3002
MEET_APP_URL=http://localhost:3001
MEMBERSHIP_APP_URL=http://localhost:3005
# Where the API sends a browser to sign in during an MCP/OAuth grant
# FIBRE_WEB_URL=http://localhost:3000

# ============================================================
# Integrations — each block switches one feature on
# ============================================================

# --- Email (Resend). Empty key = emails are logged, not sent ---------------
RESEND_API_KEY=
# The live sender on each stack is this secret, which wins over the default in
# branding.ts. The domain must be verified in Resend or nothing sends.
EMAIL_FROM="The Thread <noreply@thethread.app>"

# --- Google OAuth (calendar connect in Meet and Thread) --------------------
# Sign-in with Google is configured in the Supabase Auth dashboard, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the OAuth state. Generate with: openssl rand -hex 32
GOOGLE_STATE_SECRET=

# --- Zoom (meeting links; docs/zoom-app-setup.md) ---------------------------
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Verifies Zoom's webhooks, incl. the deauthorization notice
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Stripe (docs/platform-billing-setup.md) --------------------------------
STRIPE_SECRET_KEY=
# One endpoint, one secret, four times. Only Thread's has a fallback.
# Meet bookings
STRIPE_WEBHOOK_SECRET=
# Thread enrolments (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_THREAD_WEBHOOK_SECRET=
# Platform subscriptions (routes/billing.ts — no fallback: a webhook verified
# against the wrong secret is a silent outage)
STRIPE_BILLING_WEBHOOK_SECRET=
# Membership subscriptions (routes/membership.ts — no fallback, same reason)
STRIPE_MEMBERSHIP_WEBHOOK_SECRET=
# Stripe Connect onboarding (the ca_… id). Empty = the Connect button is hidden
STRIPE_CONNECT_CLIENT_ID=

# --- In-app assistant (docs/in-app-assistant.md). Empty = no assistant ------
ANTHROPIC_API_KEY=
# Root for encrypting stored credentials (a workspace's own model key, MCP
# grant sessions). Falls back to SSO_INTERNAL_SECRET when empty.
# Generate with: openssl rand -hex 32
ASSISTANT_KEY_SECRET=
# Where the assistant's tools call this API; defaults to 127.0.0.1:API_PORT
# ASSISTANT_API_BASE=

# --- Circle community sync (Members) ----------------------------------------
# Only for a community on a plan that speaks a different API version
# CIRCLE_API_BASE=

# --- Wallet passes for check-in tickets. Empty = no wallet buttons ----------
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY_PEM=
